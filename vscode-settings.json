{
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "editor.wordWrap": "on",
  "editor.lineNumbers": "relative",
  "editor.cursorSurroundingLines": 10,
  "editor.renderWhitespace": "trailing",
  "editor.minimap.enabled": false,
  "editor.scrollBeyondLastLine": false,
  "editor.smoothScrolling": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorBlinking": "solid",
  "editor.cursorStyle": "block",
  "editor.fontSize": 14,
  "editor.fontFamily": "JetBrains Mono, Fira Code, Menlo, Monaco, monospace",
  "editor.fontLigatures": true,
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.guides.indentation": true,
  "editor.linkedEditing": true,
  "editor.inlineSuggest.enabled": true,
  "editor.suggestSelection": "first",
  "editor.acceptSuggestionOnEnter": "on",
  "editor.quickSuggestions": {
    "other": "on",
    "comments": "off",
    "strings": "on"
  },

  "editor.find.autoFindInSelection": "never",
  "search.smartCase": true,
  "search.showLineNumbers": true,

  "vim.leader": "<space>",
  "vim.hlsearch": true,
  "vim.incsearch": true,
  "vim.ignorecase": true,
  "vim.smartcase": true,
  "vim.useSystemClipboard": true,
  "vim.highlightedyank.enable": true,
  "vim.highlightedyank.duration": 200,
  "vim.smartRelativeLine": true,
  "vim.sneak": true,
  "vim.sneakUseIgnorecaseAndSmartcase": true,
  "vim.easymotion": true,
  "vim.surround": true,
  "vim.targets.enable": true,
  "vim.timeout": 2000,
  "vim.showMarksInGutter": true,
  "vim.handleKeys": {
    "<C-a>": false,
    "<C-f>": false,
    "<C-b>": false,
    "<C-c>": false,
    "<C-v>": false,
    "<C-x>": false,
    "<C-z>": false,
    "<C-p>": false,
    "<C-n>": false
  },

  "vim.insertModeKeyBindings": [{ "before": ["j", "k"], "after": ["<Esc>"] }],

  "vim.normalModeKeyBindingsNonRecursive": [
    { "before": ["<leader>", "n", "h"], "commands": [":nohl"] },
    { "before": ["<leader>", "+"], "after": ["<C-a>"] },
    { "before": ["<leader>", "-"], "after": ["<C-x>"] },

    {
      "before": ["<leader>", "h"],
      "commands": ["workbench.action.focusLeftGroup"]
    },
    {
      "before": ["<leader>", "l"],
      "commands": ["workbench.action.focusRightGroup"]
    },
    {
      "before": ["<leader>", "j"],
      "commands": ["workbench.action.focusBelowGroup"]
    },
    {
      "before": ["<leader>", "k"],
      "commands": ["workbench.action.focusAboveGroup"]
    },

    {
      "before": ["<leader>", "s", "v"],
      "commands": ["workbench.action.splitEditor"]
    },
    {
      "before": ["<leader>", "s", "h"],
      "commands": ["workbench.action.splitEditorDown"]
    },
    {
      "before": ["<leader>", "s", "e"],
      "commands": ["workbench.action.evenEditorWidths"]
    },
    {
      "before": ["<leader>", "s", "x"],
      "commands": ["workbench.action.closeActiveEditor"]
    },
    {
      "before": ["<leader>", "s", "m"],
      "commands": ["workbench.action.toggleMaximizeEditorGroup"]
    },
    {
      "before": ["<leader>", "s", "t"],
      "commands": ["workbench.action.terminal.toggleTerminal"]
    },

    {
      "before": ["<leader>", "t", "o"],
      "commands": ["workbench.action.files.newUntitledFile"]
    },
    {
      "before": ["<leader>", "t", "x"],
      "commands": ["workbench.action.closeActiveEditor"]
    },
    {
      "before": ["<leader>", "t", "l"],
      "commands": ["workbench.action.nextEditor"]
    },
    {
      "before": ["<leader>", "t", "h"],
      "commands": ["workbench.action.previousEditor"]
    },
    {
      "before": ["<leader>", "t", "f"],
      "commands": ["workbench.action.moveEditorToNewWindow"]
    },

    {
      "before": ["<leader>", "<space>"],
      "commands": ["workbench.action.quickOpen"]
    },
    {
      "before": ["<leader>", ":"],
      "commands": ["workbench.action.showCommands"]
    },
    { "before": ["<leader>", "n"], "commands": ["notifications.showList"] },
    {
      "before": ["<leader>", "e", "e"],
      "commands": ["workbench.view.explorer"]
    },
    {
      "before": ["<leader>", "e", "f"],
      "commands": ["workbench.files.action.showActiveFileInExplorer"]
    },
    {
      "before": ["<leader>", "f", "b"],
      "commands": ["workbench.action.showAllEditors"]
    },
    {
      "before": ["<leader>", "f", "c"],
      "commands": ["workbench.action.openSettingsJson"]
    },
    {
      "before": ["<leader>", "f", "s"],
      "commands": ["workbench.action.findInFiles"]
    },
    {
      "before": ["<leader>", "f", "f"],
      "commands": ["workbench.action.quickOpen"]
    },
    {
      "before": ["<leader>", "f", "r"],
      "commands": ["workbench.action.openRecent"]
    },
    {
      "before": ["<leader>", "f", "g"],
      "commands": ["workbench.action.quickOpen"]
    },
    {
      "before": ["<leader>", "f", "p"],
      "commands": ["workbench.action.openRecent"]
    },

    {
      "before": ["<leader>", "p", "l"],
      "commands": ["numberedBookmarks.listFromAllFiles"]
    },
    {
      "before": ["<leader>", "p", "a"],
      "commands": ["numberedBookmarks.toggleBookmark0"]
    },
    {
      "before": ["<leader>", "p", "n"],
      "commands": ["numberedBookmarks.jumpToNext"]
    },
    {
      "before": ["<leader>", "p", "p"],
      "commands": ["numberedBookmarks.jumpToPrevious"]
    },
    {
      "before": ["<leader>", "1"],
      "commands": ["numberedBookmarks.jumpToBookmark1"]
    },
    {
      "before": ["<leader>", "2"],
      "commands": ["numberedBookmarks.jumpToBookmark2"]
    },
    {
      "before": ["<leader>", "3"],
      "commands": ["numberedBookmarks.jumpToBookmark3"]
    },
    {
      "before": ["<leader>", "4"],
      "commands": ["numberedBookmarks.jumpToBookmark4"]
    },
    {
      "before": ["<leader>", "5"],
      "commands": ["numberedBookmarks.jumpToBookmark5"]
    },
    {
      "before": ["<leader>", "6"],
      "commands": ["numberedBookmarks.jumpToBookmark6"]
    },
    {
      "before": ["<leader>", "7"],
      "commands": ["numberedBookmarks.jumpToBookmark7"]
    },
    {
      "before": ["<leader>", "8"],
      "commands": ["numberedBookmarks.jumpToBookmark8"]
    },
    {
      "before": ["<leader>", "9"],
      "commands": ["numberedBookmarks.jumpToBookmark9"]
    },

    {
      "before": ["<leader>", "z", "z"],
      "commands": ["workbench.panel.chat.view.copilot.focus"]
    },
    { "before": ["<leader>", "z", "t"], "commands": ["inlineChat.start"] },
    {
      "before": ["<leader>", "z", "e", "s"],
      "commands": ["github.copilot.interactiveEditor.explain"]
    },
    {
      "before": ["<leader>", "z", "e", "j"],
      "commands": ["github.copilot.interactiveEditor.explain"]
    },
    { "before": ["<leader>", "z", "r"], "commands": ["editor.action.rename"] },
    {
      "before": ["<leader>", "z", "f"],
      "commands": ["editor.action.refactor"]
    },
    {
      "before": ["<leader>", "z", "g", "t"],
      "commands": ["github.copilot.interactiveEditor.generateTests"]
    },
    {
      "before": ["<leader>", "z", "s", "i"],
      "commands": ["github.copilot.interactiveEditor.review"]
    },

    {
      "before": ["<leader>", "x", "w"],
      "commands": ["workbench.actions.view.problems"]
    },
    {
      "before": ["<leader>", "x", "d"],
      "commands": ["workbench.actions.view.problems"]
    },
    {
      "before": ["<leader>", "x", "q"],
      "commands": ["workbench.action.showErrorsWarnings"]
    },
    {
      "before": ["<leader>", "x", "t"],
      "commands": ["todo-tree.showOnlyThisFile"]
    },
    { "before": ["]", "d"], "commands": ["editor.action.marker.next"] },
    { "before": ["[", "d"], "commands": ["editor.action.marker.prev"] },

    {
      "before": ["<leader>", "d", "c"],
      "commands": ["workbench.action.debug.continue"]
    },
    {
      "before": ["<leader>", "d", "b"],
      "commands": ["editor.debug.action.toggleBreakpoint"]
    },
    {
      "before": ["<leader>", "d", "s"],
      "commands": ["workbench.action.debug.stepOver"]
    },
    {
      "before": ["<leader>", "d", "i"],
      "commands": ["workbench.action.debug.stepInto"]
    },
    {
      "before": ["<leader>", "d", "o"],
      "commands": ["workbench.action.debug.stepOut"]
    },
    {
      "before": ["<leader>", "d", "r"],
      "commands": ["workbench.debug.action.toggleRepl"]
    },
    {
      "before": ["<leader>", "d", "l"],
      "commands": ["workbench.action.debug.start"]
    },
    { "before": ["<leader>", "d", "t"], "commands": ["workbench.view.debug"] },
    {
      "before": ["<leader>", "d", "x"],
      "commands": ["workbench.action.debug.stop"]
    },

    { "before": ["<leader>", "g", "b"], "commands": ["git.checkout"] },
    { "before": ["<leader>", "g", "l"], "commands": ["gitlens.showGraph"] },
    {
      "before": ["<leader>", "g", "L"],
      "commands": ["gitlens.showFileHistoryView"]
    },
    { "before": ["<leader>", "g", "s"], "commands": ["workbench.view.scm"] },
    { "before": ["<leader>", "g", "S"], "commands": ["git.stash"] },
    { "before": ["<leader>", "g", "d"], "commands": ["git.openChange"] },
    {
      "before": ["<leader>", "g", "f"],
      "commands": ["gitlens.showQuickFileHistory"]
    },
    { "before": ["<leader>", "g", "g"], "commands": ["lazygit.toggle"] },

    {
      "before": ["]", "h"],
      "commands": ["workbench.action.editor.nextChange"]
    },
    {
      "before": ["[", "h"],
      "commands": ["workbench.action.editor.previousChange"]
    },
    {
      "before": ["<leader>", "h", "s"],
      "commands": ["git.stageSelectedRanges"]
    },
    {
      "before": ["<leader>", "h", "r"],
      "commands": ["git.revertSelectedRanges"]
    },
    { "before": ["<leader>", "h", "S"], "commands": ["git.stageAll"] },
    { "before": ["<leader>", "h", "R"], "commands": ["git.cleanAll"] },
    {
      "before": ["<leader>", "h", "p"],
      "commands": ["editor.action.dirtydiff.next"]
    },
    {
      "before": ["<leader>", "h", "b"],
      "commands": ["gitlens.toggleLineBlame"]
    },
    {
      "before": ["<leader>", "l", "b"],
      "commands": ["gitlens.toggleLineBlame"]
    },
    { "before": ["<leader>", "h", "d"], "commands": ["git.openChange"] },

    { "before": ["g", "d"], "commands": ["editor.action.revealDefinition"] },
    { "before": ["g", "D"], "commands": ["editor.action.revealDeclaration"] },
    { "before": ["g", "r"], "commands": ["editor.action.goToReferences"] },
    { "before": ["g", "I"], "commands": ["editor.action.goToImplementation"] },
    { "before": ["g", "y"], "commands": ["editor.action.goToTypeDefinition"] },
    { "before": ["K"], "commands": ["editor.action.showHover"] },
    {
      "before": ["<leader>", "c", "a"],
      "commands": ["editor.action.quickFix"]
    },
    { "before": ["<leader>", "r", "n"], "commands": ["editor.action.rename"] },
    {
      "before": ["<leader>", "r", "s"],
      "commands": ["workbench.action.restartExtensionHost"]
    },

    {
      "before": ["<leader>", "m", "p"],
      "commands": ["editor.action.formatDocument"]
    },

    {
      "before": ["<leader>", "u", "w"],
      "commands": ["editor.action.toggleWordWrap"]
    },
    {
      "before": ["<leader>", "u", "l"],
      "commands": ["settings.cycle.lineNumbers"]
    },
    {
      "before": ["<leader>", "u", "d"],
      "commands": ["workbench.actions.view.problems"]
    },
    {
      "before": ["<leader>", "u", "b"],
      "commands": ["workbench.action.toggleLightDarkThemes"]
    },
    {
      "before": ["<leader>", "u", "g"],
      "commands": ["editor.action.toggleRenderWhitespace"]
    },
    {
      "before": ["<leader>", "u", "m"],
      "commands": ["editor.action.toggleMinimap"]
    },
    {
      "before": ["<leader>", "u", "z"],
      "commands": ["workbench.action.toggleZenMode"]
    },

    {
      "before": ["<leader>", "q"],
      "commands": ["workbench.action.closeActiveEditor"]
    },
    {
      "before": ["<leader>", "w"],
      "commands": ["workbench.action.files.save"]
    },
    {
      "before": ["<leader>", "W"],
      "commands": ["workbench.action.files.saveAll"]
    }
  ],

  "vim.visualModeKeyBindingsNonRecursive": [
    { "before": ["<leader>", "z", "t"], "commands": ["inlineChat.start"] },
    { "before": ["<leader>", "z", "r"], "commands": ["inlineChat.start"] },
    {
      "before": ["<leader>", "z", "f"],
      "commands": ["editor.action.refactor"]
    },
    {
      "before": ["<leader>", "c", "a"],
      "commands": ["editor.action.quickFix"]
    },
    {
      "before": ["<leader>", "m", "p"],
      "commands": ["editor.action.formatSelection"]
    },
    {
      "before": ["<leader>", "h", "s"],
      "commands": ["git.stageSelectedRanges"]
    },
    {
      "before": ["<leader>", "h", "r"],
      "commands": ["git.revertSelectedRanges"]
    },
    { "before": ["J"], "commands": ["editor.action.moveLinesDownAction"] },
    { "before": ["K"], "commands": ["editor.action.moveLinesUpAction"] },
    {
      "before": [">"],
      "commands": ["editor.action.indentLines"],
      "after": ["g", "v"]
    },
    {
      "before": ["<"],
      "commands": ["editor.action.outdentLines"],
      "after": ["g", "v"]
    }
  ],

  "terminal.integrated.defaultProfile.osx": "zsh",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.cursorStyle": "block",
  "terminal.integrated.cursorBlinking": false,

  "workbench.colorTheme": "Tokyo Night",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.startupEditor": "none",
  "workbench.editor.enablePreview": false,
  "workbench.editor.showTabs": "multiple",
  "workbench.sideBar.location": "left",
  "window.commandCenter": false,
  "breadcrumbs.enabled": true,

  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit"
  },
  "[javascript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescript]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[javascriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[typescriptreact]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[vue]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[json]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[html]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[css]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[scss]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[markdown]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[yaml]": { "editor.defaultFormatter": "esbenp.prettier-vscode" },
  "[lua]": { "editor.defaultFormatter": "JohnnyMorganz.stylua" },
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
    "editor.codeActionsOnSave": { "source.organizeImports": "explicit" }
  },
  "[csharp]": {
    "editor.defaultFormatter": "csharpier.csharpier-vscode",
    "editor.formatOnSave": true
  },
  "[go]": { "editor.defaultFormatter": "golang.go" },
  "[razor]": { "editor.formatOnSave": false },

  "typescript.updateImportsOnFileMove.enabled": "always",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "typescript.preferences.importModuleSpecifier": "relative",
  "javascript.preferences.importModuleSpecifier": "relative",

  "dotnetAcquisitionExtension.enableTelemetry": false,
  "csharp.inlayHints.enableForParameters": true,
  "csharp.inlayHints.enableForImplicitVariableTypes": true,

  "github.copilot.enable": {
    "*": true,
    "markdown": true,
    "plaintext": true
  },
  "github.copilot.chat.localeOverride": "en",

  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "gitlens.currentLine.enabled": true,

  "files.autoSave": "onFocusChange",
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.exclude": {
    "**/.git": true,
    "**/.DS_Store": true,
    "**/node_modules": true,
    "**/bin": true,
    "**/obj": true
  },
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,

  "todo-tree.general.tags": ["TODO", "FIXME", "BUG", "HACK", "NOTE", "XXX"],
  "todo-tree.highlights.defaultHighlight": {
    "icon": "alert",
    "type": "text-and-comment",
    "foreground": "#FF8C00"
  },

  "numberedBookmarks.saveBookmarksInProject": true,
  "numberedBookmarks.navigateThroughAllFiles": true
}
